# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Sentry (opcional)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Email Service (Resend)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=pedidos@yjbmotocom.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://yjbmotocom.com

# Cron jobs (Vercel Cron) — protege /api/cron/* de que cualquiera las
# llame directamente. Genera un valor aleatorio largo, ej: openssl rand -hex 32
CRON_SECRET=

# Analytics (Opcional - configurar solo si se va a usar)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_API_HOST=https://app.posthog.com

# ============================================================
# Alegra API — Integración YJBMOTOCOM (Cierre Alegra)
# ============================================================
# Credenciales de tu cuenta en app.alegra.com > Configuración > API
ALEGRA_USER=tu_email@gmail.com
ALEGRA_TOKEN=tu_token_de_alegra
ALEGRA_API_BASE_URL=https://api.alegra.com/api/v1
ALEGRA_TIMEOUT=30

# Parámetros del Cierre de Caja
# BASE_OBJETIVO: monto objetivo de la base en pesos COP (ej. 450000 = $450,000)
BASE_OBJETIVO=450000
# UMBRAL_MENUDO: límite de monedas sueltas en el conteo
UMBRAL_MENUDO=10000
